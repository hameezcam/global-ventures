# ==============================================================================
# GLOBAL VENTURES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Public Application URL
NEXT_PUBLIC_SITE_URL=https://globalventures.com

# Inquiries & Mandate Dispatch (Optional Cloud Integrations)
# If left blank, the application will durably store inquiries in data/enquiries.jsonl
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=advisory@globalventures.com
NOTIFICATION_EMAIL_FROM=notifications@globalventures.com

# External CRM Webhook (HubSpot, Salesforce, Make.com)
ENQUIRY_WEBHOOK_URL=

# Database Connection (PostgreSQL / Supabase / Prisma if deployed to serverless)
DATABASE_URL=

# Rate Limiting & Anti-Abuse (Upstash Redis for distributed clusters)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
