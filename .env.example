# ==============================================================================
# GLOBAL VENTURE — ENVIRONMENT CONFIGURATION TEMPLATE
# Never commit real values. On Vercel these are set by the integrations.
# ==============================================================================

# Public Application URL (used for metadata and as an allowed form origin)
NEXT_PUBLIC_SITE_URL=https://globalventure.ae

# ------------------------------------------------------------------------------
# PostgreSQL (Prisma Postgres via the Vercel Marketplace integration)
# ------------------------------------------------------------------------------
# Direct connection: used by `npm run db:migrate` (and by vercel-build).
DATABASE_URL=
# Pooled connection: preferred by the API at runtime when present.
DATABASE_URL_POOLED=
# Also injected by the integration but not used by this app:
#   DATABASE_POSTGRES_URL, DATABASE_PRISMA_DATABASE_URL (Prisma Accelerate URL)

# Optional: dedicated secret for hashing rate-limit keys (IPs, emails).
# If unset, a key derived from the server-only DATABASE_URL is used.
RATE_LIMIT_SECRET=

# ------------------------------------------------------------------------------
# Not implemented yet (enquiry notifications / CRM forwarding)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=
ENQUIRY_WEBHOOK_URL=
